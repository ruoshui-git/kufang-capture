# Generate the Argon2 password hash with: uv run python -m kufang_capture.hashpw
CAPTURE_PASSWORD_HASH=replace-with-argon2-hash
# Generate at least 32 random bytes and store the result only on the VPS.
CAPTURE_SESSION_SECRET=replace-with-random-session-secret
CAPTURE_PUBLIC_ORIGIN=https://capture.kufang.org
