FROM node:26-slim AS frontend-build
WORKDIR /workspace/frontend
RUN npm install --global pnpm@12
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
RUN pnpm build

FROM ghcr.io/astral-sh/uv:0.9.5 AS uv-bin

FROM python:3.13-slim AS runtime
COPY --from=uv-bin /uv /uvx /bin/
ENV UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH" \
    CAPTURE_DATA_DIR=/data \
    CAPTURE_STATIC_DIR=/app/static
WORKDIR /app
COPY backend/pyproject.toml backend/uv.lock ./backend/
COPY backend/src ./backend/src
RUN uv sync --project backend --frozen --no-dev
COPY --from=frontend-build /workspace/frontend/dist /app/static
ARG APP_VERSION=dev
ENV CAPTURE_APP_VERSION=${APP_VERSION}
LABEL org.opencontainers.image.source="https://github.com/ruoshui-git/kufang-capture" \
      org.opencontainers.image.title="Kufang Capture" \
      org.opencontainers.image.version="${APP_VERSION}"
RUN useradd --system --uid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin capture \
    && mkdir -p /data \
    && chown 10001:10001 /data
VOLUME ["/data"]
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=2)" || exit 1
CMD ["uvicorn", "kufang_capture.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*"]
