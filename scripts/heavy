#!/usr/bin/env bash
set -Eeuo pipefail

# Run memory-heavy commands (builds, Playwright, image builds) through a small
# number of shared slots. Parallel agents in this repository and its worktrees
# queue here instead of exhausting the WSL VM's memory. One E2E run or build
# needs about 1 GiB, so the default of 4 slots fits comfortably in 13 GiB.
# CAPTURE_HEAVY_SLOTS=1 restores strict one-at-a-time behaviour.

if [[ $# -eq 0 ]]; then
	echo "Usage: heavy COMMAND [ARGS...]" >&2
	exit 2
fi
repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# Worktrees share the main checkout's lock directory so slots are global.
common=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || echo "$repo/.git")
lockdir="${CAPTURE_HEAVY_LOCK_DIR:-$(dirname -- "$common")/.locks}"
mkdir -p "$lockdir"
slots="${CAPTURE_HEAVY_SLOTS:-4}"

acquire() {
	local i
	for ((i = 1; i <= slots; i++)); do
		exec 9>"$lockdir/heavy.$i.lock"
		if flock -n 9; then return 0; fi
		exec 9>&-
	done
	return 1
}

if ! acquire; then
	echo "heavy: all $slots slots busy, waiting ($lockdir)" >&2
	until acquire; do sleep 2; done
fi
"$@"
