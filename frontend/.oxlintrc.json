{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["dist", "coverage", "test-results", "playwright-report", "src/lib/paraglide"],
  "overrides": [
    {
      "files": ["*.svelte"],
      "rules": {
        "no-unused-expressions": "off"
      }
    },
    {
      "files": ["*.test.ts"],
      "rules": {
        "typescript/no-this-alias": "off"
      }
    }
  ]
}
