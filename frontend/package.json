{
  "name": "kufang-capture-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test --project=iphone-chromium --project=desktop-chromium",
    "generate-pwa-assets": "pwa-assets-generator --root public --config pwa-assets.config.ts",
    "test:e2e:webkit": "docker run --rm --ipc=host --network host -v \"$PWD/..:/repo\" -w /repo/frontend -e E2E_BASE_URL=${E2E_BASE_URL:-http://127.0.0.1:8123} mcr.microsoft.com/playwright:v1.65.0-noble npx playwright test --project=iphone-webkit"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.2",
    "@vite-pwa/assets-generator": "^2.0.0",
    "fake-indexeddb": "^6.2.7",
    "fflate": "^0.8.3",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@lucide/svelte": "^1.70.0",
    "dexie": "^4.4.7",
    "ulid": "^3.0.2",
    "workbox-window": "^7.4.1"
  }
}
